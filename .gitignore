# Dependencies
# Stores packages installed from npm. Should always be in .gitignore.
/node_modules
/package-lock.json
/yarn.lock
/pnpm-lock.yaml

# Local Environment Variables
# Used for storing sensitive data like API keys, tokens, and database credentials.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# WhatsApp Web Session Data
# CRITICAL: This folder contains your WhatsApp authentication session.
# Sharing it would allow anyone to access your WhatsApp account.
.wwebjs_auth
.wwebjs_cache
# Also ignore the older .wa-... session folders if you have them
.wa-for-[a-z0-9]{40}

# Logs
# Contains application logs, which can be large and are not needed in version control.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
/pnpm-debug.log*

# Runtime data
# Files generated by tools like pnpm or during runtime.
/pids
/*.pid
/*.seed
/*.pid.lock

# Coverage directory used by tools like istanbul
/coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage
.grunt

# Bower dependency directory
/bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons
/build/Release

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env.test

# parcel-bundler cache
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
/dist

# Gatsby files
.cache/
#public

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Editor directories and files
# Prevents editor-specific settings from being committed.
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
# Prevents system-specific files from being committed.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Serverless build directories
.serverless/

# FuseBox cache
.fusebox/